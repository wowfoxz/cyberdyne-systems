[Unit]
Description=Sitio estatico de Cyberdyne Systems
After=network.target

[Service]
User=pi2
WorkingDirectory=/home/pi2/cyberdyne-public
ExecStart=/usr/bin/python3 -m http.server 8790 --bind 0.0.0.0 --directory /home/pi2/cyberdyne-public
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target

{
  "name": "cyberdyne-systems",
  "version": "0.1.0",
  "description": "Cyberdyne Systems Desktop Application",
  "author": "Guillermo Valdes",
  "main": "main.cjs",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "electron .",
    "electron:build": "npm run build && electron-builder --win nsis portable --x64"
  },
  "dependencies": {
    "@react-three/drei": "^10.0.4",
    "@react-three/fiber": "^9.1.0",
    "leaflet": "^1.9.4",
    "next": "15.2.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-leaflet": "^5.0.0",
    "three": "^0.174.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/leaflet": "^1.9.16",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^35.1.1",
    "electron-builder": "^26.0.12",
    "eslint": "^9",
    "eslint-config-next": "15.2.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "build": {
    "appId": "com.cyberdyne.systems",
    "productName": "Cyberdyne Systems",
    "icon": "build/icon.ico",
    "win": {
      "icon": "build/icon.ico",
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "artifactName": "CyberdyneSystems-instalador.${ext}"
    },
    "portable": {
      "artifactName": "CyberdyneSystems-portable.${ext}"
    },
    "files": [
      "out/**/*",
      "main.cjs",
      "package.json"
    ]
  }
}
